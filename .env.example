# ── 共用資料庫設定範本 ──────────────────────────────────
# 用法：把這個檔複製成 .env（放在專案根目錄，與此檔同層），再填入實際值。
# .env 已被 .gitignore 忽略，不會上傳，請由負責人把填好的內容私下分享給組員。
#
#   Windows PowerShell:  Copy-Item .env.example .env
#   Mac / Linux:         cp .env.example .env
# ────────────────────────────────────────────────────────

# 共用雲端 MySQL 連線資訊（向 Railway / Aiven / Zeabur 等平台申請後填入）
DB_NAME=course_platform_db
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=your_db_host
DB_PORT=3306

# 只有平台要求 TLS 時才填（例如 Aiven 會給一個 ca.pem，填它的完整路徑）
# DB_SSL_CA=C:\path\to\ca.pem

# 開發時維持 True；正式部署再改 False
DEBUG=True

# Django 的簽章金鑰（session、密碼重設連結都靠它）。
# 沒設的話啟動時會自動產生一把「只在這次執行有效」的開發用金鑰：
# 程式仍可跑，但每次重啟都會把所有登入狀態與重設連結作廢。
# 每位組員各自產一把即可，不必相同；正式部署一定要設固定值。
#   產生方式：python -c "import secrets; print(secrets.token_urlsafe(50))"
# SECRET_KEY=

# ── 密碼重設信 ────────────────────────────────────────
# 不填 EMAIL_HOST_USER 的話，重設信會直接印在終端機（開發預設，完全夠用）。
# 要真的寄信才填以下兩項：Gmail 需先開啟兩步驟驗證，再產生「應用程式密碼」
# （16 碼），填在 EMAIL_HOST_PASSWORD，不是你的 Gmail 登入密碼。
# EMAIL_HOST_USER=your_account@gmail.com
# EMAIL_HOST_PASSWORD=your_16_char_app_password
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
